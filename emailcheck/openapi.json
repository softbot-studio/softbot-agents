{"openapi":"3.1.0","info":{"title":"Softbot Email Check","version":"1.0.0","description":"Email and domain validation for AI agents, paid per call via x402 (USDC on Solana). No SMTP probing. Invalid input (400) and upstream DNS failures (502) are not charged. Disposable list: disposable-email-domains (CC0 1.0)."},"servers":[{"url":"https://softbot-emailcheck-mainnet.softbot.workers.dev"}],"paths":{"/v1/email":{"post":{"summary":"Check one email address","description":"Email address check: verdict (deliverable_likely/risky/invalid) with reasons from syntax, MX/A records, disposable-provider list, role address, free provider, typo suggestion, SPF/DMARC/DKIM and domain age. Use when an agent is about to send to, sign up, or accept an email address and wants to avoid bounces, throwaway or mistyped addresses. One address per call; no SMTP mailbox probing.","x-x402":{"price_usdc":0.002,"network":"solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp"},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["email"],"properties":{"email":{"type":"string","description":"Single email address"}}}}}},"responses":{"200":{"description":"Verdict","content":{"application/json":{"schema":{"type":"object","properties":{"email":{"type":"string"},"domain":{"type":"string"},"role_address":{"type":"boolean"},"typo_suggestion_email":{"type":["string","null"]},"verdict":{"type":"string","enum":["deliverable_likely","risky","invalid"]},"reasons":{"type":"array","items":{"type":"object","properties":{"code":{"type":"string"},"severity":{"type":"string","enum":["info","warn","fail"]},"detail":{"type":"string"}}}},"dns":{"type":"object"},"auth":{"type":"object"},"disposable":{"type":"boolean"},"free_provider":{"type":"boolean"},"typo_suggestion":{"type":["string","null"]},"domain_age":{"type":"object"}}}}}},"400":{"description":"Invalid input (not charged)"},"402":{"description":"Payment required (x402)"},"5XX":{"description":"Upstream DNS failure (not charged)"}