{
  "name": "softbot-mcp",
  "version": "0.1.0",
  "description": "MCP server for Softbot Studio pay-per-call agent tools (x402, USDC on Solana): read pages, extract data, token/wallet/email/website checks, screenshots, PDFs.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "x402",
    "solana",
    "usdc",
    "ai-agents",
    "web-scraping",
    "screenshot"
  ],
  "author": "Softbot Studio <softbot@mail.grokbot.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@solana/kit": "^5.5.1",
    "@x402/fetch": "^2.28.0",
    "@x402/svm": "^2.28.0",
    "bs58": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "bin": {
    "softbot-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "homepage": "https://softbot-studio.pages.dev/",
  "mcpName": "io.github.softbot-studio/softbot-mcp",
  "engines": {
    "node": ">=20"
  }
}